{
  "title": "Agent Quality & Reliability Lab \u2014 Requirement Evidence & Live Metrics",
  "uid": "agent-quality-lab",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Demo. Missing live runtime evidence is No Data, not success. SLOs reflect a bounded local HTTP test. Bug-cycle is a synthetic red/green fixture, not an actual customer fix.",
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (requests/sec)",
      "id": 1,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(aq_triage_requests_total[1m]))",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p95 agent latency (seconds)",
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(aq_triage_latency_seconds_bucket[5m])))",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Model fallback events / 5 min",
      "id": 3,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(increase(aq_model_fallback_total[5m]))",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
