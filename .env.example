# Defaults work WITHOUT an LLM. Copy as .env only if you want to customize.
AQ_MODE=deterministic
# Choose ollama or openai_compatible only after configuring an inference backend.
AQ_MODEL=llama3.2:1b
AQ_OLLAMA_URL=http://127.0.0.1:11434
AQ_OPENAI_BASE_URL=http://127.0.0.1:8001/v1
AQ_API_KEY=
AQ_TIMEOUT_SECONDS=30
# Only for local demo, NEVER on exposed production deployments.
AQ_ENABLE_FAULTS=0
# Optional explicit accelerator NIM inference configuration. Default targets LOCAL service.
# If using a hosted endpoint, supply its documented /v1 base URL and API key.
AQ_NIM_BASE_URL=http://127.0.0.1:8001/v1
AQ_NIM_MODEL=your-deployed-nim-model-id
AQ_NIM_API_KEY=
# QA report folder read by the metrics endpoint.
AQ_ARTIFACT_DIR=artifacts
